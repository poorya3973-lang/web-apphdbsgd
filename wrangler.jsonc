{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apphdbsgd",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "91be282d-40ec-4573-b1de-6774a33c91ba","database_name": "web-apphdhdhd" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "328eda6f5e1d454baccde02b64ca8f51" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
